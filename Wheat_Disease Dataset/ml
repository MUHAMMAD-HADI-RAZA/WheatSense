# 🌐 Prediction State
last_prediction = {"label": None}

# 🖼️ Predict Function
def predict(image):
    image = image.resize((224, 224))
    image = np.array(image) / 255.0
    image = np.expand_dims(image, axis=0)

    preds = model.predict(image, verbose=0)
    confidence = np.max(preds)
    label = labels[np.argmax(preds)]

    last_prediction["label"] = label

    # Optional: Confidence threshold warning
    if confidence < 0.6:
        return f"⚠️ Low confidence prediction.\n🧪 Possible: {label}\n📊 Confidence: {confidence * 100:.2f}%"
    
    return f"🧪 Predicted: {label}\n📊 Confidence: {confidence * 100:.2f}%\nClick below to view treatment & disease info."

# ℹ️ Disease Info Fetcher
def more_info():
    label = last_prediction["label"]
    return disease_info.get(label, "ℹ️ No additional info available.")

# 🎛️ Gradio Interface
with gr.Blocks() as demo:
    gr.Markdown("## 🌾 Wheat Disease Detector (Google Lens Style)")

    with gr.Row():
        image_input = gr.Image(type="pil", label="📷 Upload Wheat Leaf Image")
        prediction_output = gr.Textbox(label="Prediction", lines=3)

    more_btn = gr.Button("📖 Show More Info")
    info_output = gr.Textbox(label="Disease Info", lines=10)

    image_input.change(fn=predict, inputs=image_input, outputs=prediction_output)
    image_input.change(fn=lambda: "", outputs=info_output)  # Clear info when new image is loaded
    more_btn.click(fn=more_info, outputs=info_output)

demo.launch()
